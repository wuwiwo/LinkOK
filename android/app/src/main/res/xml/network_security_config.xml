<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9 (API 28) 起，明文 HTTP 默认被系统禁止。若不显式放行，
  所有请求都会抛 java.net.UnknownServiceException:
  "CLEARTEXT communication to 192.168.x.x not permitted by network security policy"。

  LinkOK 的整个前提就是「纯局域网、无云端、无 TLS」，Hub 监听的是
  http://<DHCP 分配的局域网 IP>:8787。IP 每次重连都可能变化，所以不能
  用 <domain-config> 枚举具体地址（该元素只匹配字面主机名，不支持 CIDR 网段）。

  结论：放行明文。风险范围由以下三点共同约束，而不是靠这一行配置：
    1. Hub 绑定在局域网，不对外网暴露；
    2. 每个请求都要求 Bearer Token，配对码一次性且 120 秒过期；
    3. 用户明确选择「个人使用、局域网」场景（SPEC §2.2 非目标）。

  这是一条显式的、有理由的取舍，不是默认值的疏漏。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
